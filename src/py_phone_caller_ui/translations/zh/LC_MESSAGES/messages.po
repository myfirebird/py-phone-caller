#: src/py_phone_caller_ui/prober/templates/prober/records.html:18
msgid "Refresh"
msgstr "刷新"

msgid "Duty Group Endpoints:"
msgstr "值班组接口地址："

msgid "Pick the endpoint matching the channels you want; the URL suffix selects the notification mode."
msgstr "按需要的通知渠道选择接口，URL 后缀决定通知方式。"

msgid "Target a specific duty group:"
msgstr "指定值班组："

msgid "The group name and token are shown on the Duty & Prober page; ?group= also lets the receiver use that roster instead of the default receivers."
msgstr "值班组名称与 token 在“值班与拨测”页面可见；带 ?group= 时接收端会使用该组的值班人员而不是默认接收人。"

msgid "Authentication:"
msgstr "鉴权方式："

msgid "Pass the service token or a duty-group token as ?token=T, Header X-Webhook-Token: T, Header X-API-Key: T, or Authorization: Bearer T."
msgstr "服务 token 或值班组 token 可通过 ?token=T、请求头 X-Webhook-Token: T、X-API-Key: T 或 Authorization: Bearer T 传入。"

msgid "Accepted payloads:"
msgstr "支持的请求体："

msgid "Alertmanager: {"alerts":[{"status":"firing","annotations":{"description":"..."}}]} - only firing descriptions are dispatched."
msgstr "Alertmanager：{"alerts":[{"status":"firing","annotations":{"description":"..."}}]}，仅 firing 状态的描述会被外呼/短信。"

msgid "Zabbix / generic JSON: {"subject":"PROBLEM: ...","message":"{ALERT.MESSAGE}"} - message wins, then subject, body, content, description, title."
msgstr "Zabbix / 通用 JSON：{"subject":"PROBLEM: ...","message":"{ALERT.MESSAGE}"}，优先取 message，其次 subject、body、content、description、title。"

msgid "Zabbix script media: raw text body (Content-Type: text/plain) - the whole body becomes the alert message."
msgstr "Zabbix 脚本媒体：纯文本请求体（Content-Type: text/plain），整段正文即为告警内容。"

msgid "Zabbix form media: message=...&subject=... (application/x-www-form-urlencoded)."
msgstr "Zabbix 表单媒体：message=...&subject=...（application/x-www-form-urlencoded）。"

msgid "Zabbix media type example:"
msgstr "Zabbix 媒体类型示例："

msgid "curl example:"
msgstr "curl 示例："

msgid "Incoming alerts resolve the duty roster, synthesize speech and place the calls; resolved alerts are never dispatched. Use the Test Webhook button on a duty group to verify connectivity."
msgstr "收到的告警会解析值班人员、合成语音并外呼；已恢复（resolved）的告警不会外呼。可用值班组上的“测试 Webhook”按钮验证连通性。"

msgid "Probe Trigger Webhook"
msgstr "拨测触发 Webhook"

msgid "Regenerate token"
msgstr "重新生成 token"

msgid "POST this URL from Zabbix (or any monitoring tool) to run the probe immediately; failures raise the duty-group alarm exactly like a scheduled run. Authentication uses the token in the URL."
msgstr "由 Zabbix（或任意监控系统）向该地址发送 POST 即可立即执行本拨测；失败时与定时拨测一样触发所属值班组告警。鉴权使用 URL 中的 token。"

msgid "Trigger a probe on demand (Zabbix):"
msgstr "按需触发拨测（Zabbix）："

msgid "The call is dispatched immediately on the probe queue; the normal verdict runs and a failed probe raises the bound duty-group alarm (webhook + calls), exactly like the cron schedule."
msgstr "调用后立即投递到拨测队列执行；判定流程不变，失败时与定时任务完全一致地触发所属值班组告警（Webhook + 外呼）。"

msgid "Successful response:"
msgstr "成功响应："

msgid "Zabbix action example:"
msgstr "Zabbix 动作示例："

msgid "Rename safe"
msgstr "重命名安全"

msgid "Each probe task has its own trigger URL; it is shown at the bottom of the probe edit dialog with a copy button. The URL uses the immutable probe id, so renaming the task never changes it."
msgstr "每个拨测任务都有独立的触发地址，显示在拨测编辑弹窗底部并支持一键复制。地址使用不可变的拨测 ID，因此重命名任务不会改变它。"

msgid "probe_id is permanent: renaming the task keeps the URL valid. Regenerating the token only invalidates the token part - replace ?token= in the monitoring tool and keep the same probe_id. ?probe=<name> is still accepted for convenience but is not required."
msgstr "probe_id 永久不变：重命名任务不影响已有地址；重新生成 token 只会让 token 部分失效——在监控系统中替换 ?token= 即可，probe_id 保持不变。?probe=<名称> 仍兼容但非必需。"

msgid "The group id and token are shown on the Duty & Prober page; group_id is permanent, so renaming the group never changes the URL. ?group=<name> is still accepted for compatibility."
msgstr "值班组 ID 与 token 在“值班与拨测”页面可见；group_id 永久不变，重命名值班组不会改变地址。?group=<名称> 仍兼容。"

msgid "Pick the endpoint matching the channels you want; the URL suffix selects the notification mode. /call_only and /call are equivalent, as are /sms_only and /sms."
msgstr "按需要的通知渠道选择接口，URL 后缀决定通知方式。/call_only 与 /call 等价，/sms_only 与 /sms 等价。"

msgid "Recording"
msgstr "录音"

msgid "Play"
msgstr "播放"
